[gd_scene format=3 uid="uid://cells_main_menu"]

[ext_resource type="Script" path="res://Assets/Scripts/main_menu.gd" id="1_menu"]
[ext_resource type="FontFile" path="res://Assets/Fonts/VCR_OSD_MONO_1.001.ttf" id="2_font"]

[node name="MainMenu" type="Node"]
script = ExtResource("1_menu")

[node name="CanvasLayer" type="CanvasLayer" parent="."]

[node name="Background" type="ColorRect" parent="CanvasLayer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.05, 0.05, 0.05, 1)

[node name="Center" type="VBoxContainer" parent="CanvasLayer"]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -150.0
offset_top = -100.0
offset_right = 150.0
offset_bottom = 100.0
grow_horizontal = 2
grow_vertical = 2
alignment = 1
theme_override_constants/separation = 24

[node name="Title" type="Label" parent="CanvasLayer/Center"]
layout_mode = 2
theme_override_fonts/font = ExtResource("2_font")
theme_override_font_sizes/font_size = 64
text = "CELLS"
horizontal_alignment = 1

[node name="StartButton" type="Button" parent="CanvasLayer/Center"]
layout_mode = 2
theme_override_fonts/font = ExtResource("2_font")
theme_override_font_sizes/font_size = 18
text = "Start Simulation"

[node name="QuitButton" type="Button" parent="CanvasLayer/Center"]
layout_mode = 2
theme_override_fonts/font = ExtResource("2_font")
theme_override_font_sizes/font_size = 18
text = "Quit Game"

[connection signal="pressed" from="CanvasLayer/Center/StartButton" to="." method="_on_start_pressed"]
[connection signal="pressed" from="CanvasLayer/Center/QuitButton" to="." method="_on_quit_pressed"]
